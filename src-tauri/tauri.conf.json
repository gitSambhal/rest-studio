{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RestStudio",
  "version": "1.0.0",
  "identifier": "top.suhail.rest-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RestStudio - Ultra Lightweight API Client",
        "width": 1300,
        "height": 850,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "targets": "all"
  }
}
