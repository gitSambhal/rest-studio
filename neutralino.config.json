{
  "applicationId": "top.suhail.rest-studio",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 0,
  "url": "/",
  "documentRoot": "/dist/",
  "enableServer": true,
  "enableLsp": false,
  "nativeAllowList": [
    "os.*",
    "app.*",
    "window.*",
    "filesystem.*",
    "storage.*"
  ],
  "modes": {
    "window": {
      "title": "RestStudio - Ultra Lightweight API Client",
      "width": 1300,
      "height": 850,
      "minWidth": 900,
      "minHeight": 600,
      "center": true,
      "resizable": true,
      "maximizable": true,
      "hidden": false,
      "exitProcessOnClose": true,
      "icon": "/icon.png"
    }
  },
  "cli": {
    "binaryName": "reststudio",
    "resourcesPath": "/dist/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/dist/js/neutralino.js",
    "binaryVersion": "5.6.0",
    "clientVersion": "5.6.0",
    "icon": "/public/icon.png"
  }
}
